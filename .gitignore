# Fetched third-party bytes: pinned by hash in corpus/manifest.json, never committed.
data/

# Dependencies: pinned exactly in package.json and package-lock.json.
node_modules/

# The signing key lives in the owner's 1Password vault. These are second guards in case a key path is
# ever pointed inside the repository.
*.seed
.keys/

# The signing env file for `op run --env-file=.env.sign`. Only .env.sign.example (an op:// reference,
# never a value) is tracked.
.env.sign

# OS
.DS_Store
